FROM ubuntu:22.04

# Avoid interactive prompts
ENV DEBIAN_FRONTEND=noninteractive

# Install Apache, SSH, and logging tools
RUN apt-get update && apt-get install -y \
    apache2 \
    openssh-server \
    rsyslog \
    curl \
    wget \
    nano \
    net-tools \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Configure SSH
RUN mkdir /var/run/sshd && \
    echo 'root:password' | chpasswd && \
    sed -i 's/#PermitRootLogin prohibit-password/PermitRootLogin yes/' /etc/ssh/sshd_config && \
    sed -i 's@session\s*required\s*pam_loginuid.so@session optional pam_loginuid.so@g' /etc/pam.d/sshd

# Create test users for brute force simulation
RUN useradd -m -s /bin/bash webadmin && echo 'webadmin:webpass123' | chpasswd && \
    useradd -m -s /bin/bash testuser && echo 'testuser:testpass' | chpasswd

# Configure Apache
RUN echo "ServerName localhost" >> /etc/apache2/apache2.conf && \
    a2enmod rewrite

# Create custom index page
RUN echo '<html><body><h1>SOC Lab - Ubuntu Web Server</h1><p>Target system for security monitoring</p></body></html>' > /var/www/html/index.html

# Enable rsyslog
RUN sed -i 's/#module(load="imudp")/module(load="imudp")/' /etc/rsyslog.conf && \
    sed -i 's/#input(type="imudp" port="514")/input(type="imudp" port="514")/' /etc/rsyslog.conf

# Create startup script
RUN echo '#!/bin/bash\n\
service rsyslog start\n\
service ssh start\n\
service apache2 start\n\
tail -f /var/log/apache2/access.log /var/log/apache2/error.log /var/log/auth.log\n\
' > /start.sh && chmod +x /start.sh

EXPOSE 80 22

CMD ["/start.sh"]
